# Copy to ../../.env (repo root, next to docker-compose.yml) and fill in.
# Docker Compose loads it automatically via env_file.

# Pick ONE provider:
# ANTHROPIC_API_KEY=sk-ant-...
# CURRY_LEAVES_PROVIDER=copilot   # login happens via a device code shown in the app (Settings) — visit the URL on any device

# Whisper model size: tiny | base | small | medium | large-v3 | distil-large-v3
CURRY_LEAVES_WHISPER_MODEL=small
